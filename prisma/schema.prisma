generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

// 1. Tenants (고객사 격리 단위)
model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  sites              Site[]
  auditSessions      AuditSession[]
  bulkImportBatches  BulkImportBatch[]
  auditLogs          AuditLog[]
  products           Product[]
  processes          Process[]
  boms               Bom[]
  defects            Defect[]
  copqMetrics        CopqMetric[]

  @@map("tenants")
}

// 2. RBAC Roles
model RbacRole {
  id          String  @id
  description String?
  users       User[]

  @@map("rbac_roles")
}

// 3. Users (사용자)
model User {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  roleId         String   @map("role_id")
  email          String   @unique
  name           String?
  isMfaEnabled   Boolean  @default(false) @map("is_mfa_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  role               RbacRole            @relation(fields: [roleId], references: [id])
  sites              Site[]              @relation("UserSites")
  auditSessions      AuditSession[]
  auditLogs          AuditLog[]
  bulkImportBatches  BulkImportBatch[]
  consentRecords     ConsentRecord[]

  @@map("users")
}

// 4. Sites (공장/현장 단위)
model Site {
  id          String   @id @default(uuid())
  name        String
  description String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]   @relation("UserSites")

  @@map("sites")
}

// 5. Audit Sessions (음성 수집 세션)
model AuditSession {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  status    String    @default("IN_PROGRESS")
  startTime DateTime  @default(now()) @map("start_time")
  endTime   DateTime? @map("end_time")

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  dataEntries  AuditDataEntry[]

  @@map("audit_sessions")
}

// 6. Audit Data Entries (수집 데이터 및 매핑 데이터)
model AuditDataEntry {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  rawData    Json     @map("raw_data")
  mappedData Json?    @map("mapped_data")
  createdAt  DateTime @default(now()) @map("created_at")

  session    AuditSession @relation(fields: [sessionId], references: [id])

  @@map("audit_data_entries")
}

// 7. Audit Log (Insert-only 변경 이력 로그)
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  tableName  String   @map("table_name")
  recordId   String   @map("record_id")
  action     String
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  changedBy  String?  @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [changedBy], references: [id])

  @@map("audit_log")
}

// 8. Bulk Import Batches (CSV 일괄 업로드 배치)
model BulkImportBatch {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  uploadedBy    String   @map("uploaded_by")
  fileName      String   @map("file_name")
  importType    String   @default("PRODUCT") @map("import_type")
  status        String   @default("PENDING")
  totalRows     Int      @default(0) @map("total_rows")
  processedRows Int      @default(0) @map("processed_rows")
  successCount  Int      @default(0) @map("success_count")
  failedCount   Int      @default(0) @map("failed_count")
  errors        Json?    @map("errors")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  user          User     @relation(fields: [uploadedBy], references: [id])

  @@map("bulk_import_batches")
}

// 9. Consent Records (PIPA 개인정보 수집 동의 내역)
model ConsentRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  consentType String   @map("consent_type")
  isAgreed    Boolean  @map("is_agreed")
  agreedAt    DateTime @default(now()) @map("agreed_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("consent_records")
}

// 10. Products (제품 마스터)
model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productCode String   @map("product_code")
  name        String   @map("product_name")
  spec        String?  @map("specification")
  unit        String
  clientCode  String?  @map("client_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, productCode])
  @@map("products")
}

// 11. Processes (공정 마스터)
model Process {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  processCode  String   @map("process_code")
  name         String   @map("process_name")
  lineCode     String   @map("line_code")
  cycleTimeSec Int      @map("cycle_time_sec")
  defectCodes  String?  @map("defect_codes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, processCode])
  @@map("processes")
}

// 12. Boms (BOM 마스터)
model Bom {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  parentItemCode String    @map("parent_item_code")
  childItemCode  String    @map("child_item_code")
  quantity       Float
  unit           String
  validFrom      DateTime  @map("valid_from")
  validTo        DateTime? @map("valid_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, parentItemCode, childItemCode])
  @@map("boms")
}

// 13. Defects (불량 마스터)
model Defect {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  defectCode String   @map("defect_code")
  name       String   @map("defect_name")
  category   String
  severity   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, defectCode])
  @@map("defects")
}

// 14. COPQ Metrics (품질 실패 비용 지표)
model CopqMetric {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  wasteType  String   @map("waste_type") // "defect" | "rework" | "waiting" | "overproduction"
  costValue  Decimal  @map("cost_value")
  measuredAt DateTime @map("measured_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, wasteType, measuredAt])
  @@index([tenantId, wasteType, measuredAt])
  @@map("copq_metrics")
}

// 15. NC Cases (부적합 사례 — Sprint 2 / REQ-FUNC-006~010)
model NcCase {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  reportedBy    String   @map("reported_by")
  title         String
  severity      String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status        String   @default("OPEN")   // OPEN | IN_REVIEW | CORRECTIVE | CLOSED
  rawReason     String?  @map("raw_reason")
  draftPayload  Json?    @map("draft_payload")
  beforeHash    String?  @map("before_hash")
  afterHash     String?  @map("after_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  actions       CorrectiveAction[]

  @@index([tenantId, status])
  @@map("nc_cases")
}

// 16. Corrective Actions (시정 조치 — REQ-FUNC-007/008)
model CorrectiveAction {
  id          String   @id @default(uuid())
  ncCaseId    String   @map("nc_case_id")
  description String
  ownerId     String?  @map("owner_id")
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | DONE | VERIFIED
  evidence    Json?
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ncCase      NcCase   @relation(fields: [ncCaseId], references: [id], onDelete: Cascade)

  @@index([ncCaseId, status])
  @@map("corrective_actions")
}

// 17. Vision Captures (현장 카메라 — REQ-FUNC-012)
model VisionCapture {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  uploadedBy   String   @map("uploaded_by")
  imageHash    String   @map("image_hash")
  storageKey   String   @map("storage_key")
  ocrText      String?  @map("ocr_text")
  detection    Json?
  ncCaseId     String?  @map("nc_case_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("vision_captures")
}

// 18. Audit Templates (원청 양식 — REQ-FUNC-002)
model AuditTemplate {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  name         String
  vendor       String?
  isoStandard  String   @default("ISO_9001") @map("iso_standard")
  schema       Json
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name, version])
  @@map("audit_templates")
}

// 19. AI Model Registry (Model Card — REQ-FUNC-AI-001~004 / T3-004 / T3-005)
model AiModelRegistry {
  id            String   @id @default(uuid())
  modelName     String   @map("model_name")
  version       String
  signature     String
  modelCard     Json     @map("model_card")
  isApproved    Boolean  @default(false) @map("is_approved")
  driftBaseline Json?    @map("drift_baseline")
  registeredAt  DateTime @default(now()) @map("registered_at")

  @@unique([modelName, version])
  @@map("ai_model_registry")
}
