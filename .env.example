# PRO-ALI-SMART 환경 변수 예시
# 실제 값은 .env (커밋 금지) 에 설정하세요. SRS §8 / NFR-COMPLIANCE 준수.

# ── 데이터베이스 (C-TEC-003) ─────────────────────────────
# 로컬 SQLite (기본)
DATABASE_URL="file:./prisma/dev.db"
# Supabase PostgreSQL (운영) — 사용 시 prisma/schema.prisma 의 provider 를 postgresql 로 전환
# DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres?schema=public"

# ── Supabase Auth (T1-003 / T4-003 MFA) ──────────────────
# 운영 환경에서 미들웨어가 JWT 검증에 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Genkit / Gemini (C-TEC-005~006) ─────────────────────
GOOGLE_GENAI_API_KEY=""

# ── Observability / 알림 (T4-001) ────────────────────────
ALERT_WEBHOOK_URL=""

# ── AI Drift 감지 (T3-005) ───────────────────────────────
DRIFT_THRESHOLD_PCT="5"
